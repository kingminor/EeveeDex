@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h2>Pokédex</h2>
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Classification</th>
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow row in Model.Species.Rows)
            {
                <tr>
                    <td>@row["pokedex_number"]</td>
                    <td>@row["name"]</td>
                    <td>@row["classification"]</td>
                </tr>
            }
        </tbody>
    </table>
</div>
